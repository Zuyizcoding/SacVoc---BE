# ════════════════════════════════════════════════════
# SẮC VÓC — Backend Environment Variables
# ════════════════════════════════════════════════════
# Copy file này thành .env rồi điền giá trị thật:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
#
# ⚠️ File .env KHÔNG ĐƯỢC commit lên Git (có trong .gitignore)

# --- Gemini AI ---
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30
# Total attempts per logical call (historical variable name), not extra retries.
# The SDK receives milliseconds internally; keep this file's timeout in seconds.
GEMINI_MAX_RETRIES=2
GEMINI_THINKING_BUDGET=1024

# --- Application ---
APP_NAME=Sắc Vóc API
APP_VERSION=1.0.0
DEBUG=true

# --- Database ---
# Dev: SQLite local file
DATABASE_URL=sqlite:///./sac_voc.db
# Production (Railway volume mount):
# DATABASE_URL=sqlite:////data/sac_voc.db

# --- F3 Recommendation ---
# File query vectors pre-encode bằng `python -m scripts.encode_text_queries`
F3_QUERY_VECTORS_PATH=data/query_vectors.json
F3_RUNTIME_TEXT_ENCODER_MODEL=fashion-clip

# --- Local Docker Compose binding (optional) ---
API_BIND_HOST=127.0.0.1
API_PORT=8000
